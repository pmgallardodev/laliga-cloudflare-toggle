# =============================================================================
# laliga-cloudflare-toggle - Configuration
# =============================================================================

# --- Cloudflare (required) ---

# API token with "Zone DNS Edit" permission
# Create at: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=""

# Domains to manage: ZONE_ID:DOMAIN separated by commas
# Find your Zone ID: Cloudflare dashboard > domain > Overview > right sidebar
#
# Single domain:
#   DOMAINS="abc123def456:example.com"
#
# Multiple domains:
#   DOMAINS="abc123:example.com,def456:example.org"
DOMAINS=""

# --- Telegram notifications (optional) ---

# Create a bot with @BotFather, get chat_id from @userinfobot
# Leave empty to disable notifications
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- Options ---

# Dry run mode: detect blocks without modifying Cloudflare
DRY_RUN=false

# Numbers are read in base 10 ("08" is 8) and must be in range; an invalid
# value logs WARN and falls back to the default.

# Check interval in seconds, 10-86400 (Docker only, cron users set their own schedule)
CHECK_INTERVAL=300

# Max hours to keep proxy disabled if hayahora.futbol API is unreachable or
# returns an empty/malformed response, 1-720
MAX_DISABLED_HOURS=12

# Minutes a domain must stay clear in consecutive checks before its proxy is
# restored. Stops flapping when hayahora.futbol toggles neighbour IPs.
# A new block or a hayahora.futbol outage resets the timer. 0-10080;
# 0 = restore as soon as the domain is clear.
MIN_CLEAR_MINUTES=15

# Rotate logs/toggle-proxy.log when it grows past this many bytes (keeps .1
# and .2). 0 = never rotate.
LOG_MAX_BYTES=5242880

# Hostnames that never lose the proxy (comma separated, case-insensitive)
# PROTECTED_DOMAINS="cdn.example.com"
